<header>
  {{ page.top_header}}
  <nav class="pt-11">
    {{ page.navigation}}
  </nav>
</header>
<section>
  <aside>
  {{ page.left_aside }}
  </aside>
  <main >
    {# El H1 de las paginas Canvas lo inyecta saibher_preprocess_page() en
       saibher.theme: aqui url_arguments llega vacio, por lo que no se puede
       resolver la entidad desde Twig. #}
    {{ page.content }}
  </main>
  <aside>
    {{ page.right_aside }}
  </aside>
</section>
<footer class="main-footer">
  {{ page.footer }}
</footer>